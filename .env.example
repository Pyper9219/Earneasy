MONGODB_URI=mongodb://localhost:27017/earneasy
JWT_SECRET=your-super-secret-jwt-key-change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000

FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxx
FLUTTERWAVE_WEBHOOK_HASH=your-webhook-secret-hash
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

CLIENT_PRICE_KES=450
# ---- M-Pesa (Safaricom Daraja) activation payments ----
# MPESA_ENV: sandbox | production
MPESA_ENV=sandbox
# Daraja app credentials (the "basic auth" is built from key:secret automatically)
MPESA_CONSUMER_KEY=xxxxxxxx
MPESA_CONSUMER_SECRET=xxxxxxxx
# Lipa na M-Pesa passkey from the Daraja portal
MPESA_PASSKEY=xxxxxxxx
# Paybill / Till number (Business Short Code)
MPESA_SHORTCODE=174379
# CustomerPayBillOnline for Paybill, CustomerBuyGoodsOnline for Till
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public HTTPS URL Safaricom calls after the prompt (defaults to APP_URL + /api/payments/mpesa/callback)
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/payments/mpesa/callback
