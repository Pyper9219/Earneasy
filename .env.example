MONGODB_URI=mongodb://localhost:27017/earneasy
JWT_SECRET=your-super-secret-jwt-key-change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000

FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxx
FLUTTERWAVE_WEBHOOK_HASH=your-webhook-secret-hash
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

CLIENT_PRICE_KES=450
# ---- PalPluss (M-Pesa collections) ----
# Your API key from console.palpluss.com -> Settings -> API Keys
PALPLUSS_API_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
# production | sandbox
PALPLUSS_ENV=production
# Optional: route payments through a specific Paybill/Till channel
PALPLUSS_CHANNEL_ID=
# Optional: defaults to NEXT_PUBLIC_APP_URL + /api/payments/palpluss/webhook
PALPLUSS_CALLBACK_URL=

# ---- Admin + payouts ----
# Comma separated admin emails. Defaults to the owner below.
ADMIN_EMAILS=amosmurimi217@gmail.com
# true = release withdrawals automatically via PalPluss B2C after approval
PALPLUSS_B2C=false

# ---- Email (Resend) ----
# API key from resend.com -> API Keys. Without it, emails are skipped and
# everything else keeps working.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Verified sender. onboarding@resend.dev works for testing.
EMAIL_FROM=EarnEasy <alerts@your-domain.com>
