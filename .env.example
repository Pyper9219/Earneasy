PALPLUSS_API_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
# production | sandbox
PALPLUSS_ENV=production
# Optional: route payments through a specific Paybill/Till channel
PALPLUSS_CHANNEL_ID=
# Optional: defaults to NEXT_PUBLIC_APP_URL + /api/payments/palpluss/webhook
PALPLUSS_CALLBACK_URL=